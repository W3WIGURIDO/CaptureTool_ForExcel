<Window x:Class="CaptureTool.ImageGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CaptureTool"
        mc:Ignorable="d"
        Title="ImageGridWindow" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView x:Name="photoListView" ItemsSource="{Binding Photos}" SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.Style>
                <Style TargetType="ListView">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding InlineMode}" Value="True">
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="MouseLeftButtonUp" Handler="ListViewItem_MouseLeftButtonUp" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.InlineMode, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                     Value="True">
                            <Setter Property="IsTabStop" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="300" Height="200">
                        <Image Source="{Binding ImageSource}" Visibility="{Binding CaptionVisibility}"/>
                        <TextBlock Text="{Binding Caption}" Visibility="{Binding CaptionVisibility}" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock.Background>
                                <SolidColorBrush Color="White" Opacity="0.7" />
                            </TextBlock.Background>
                        </TextBlock>
                        <Grid Visibility="{Binding DataContext.LegacyVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                              VerticalAlignment="Bottom" Height="40">
                            <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}"
                                       Visibility="{Binding CaptionVisibility}" TextTrimming="CharacterEllipsis"
                                       Background="#DDFFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                       Margin="2,0,78,2" MaxHeight="38"/>
                            <Button Content="説明編集" Visibility="{Binding CaptionVisibility}"
                                    Click="EditDescriptionButton_Click" HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom" Margin="2"/>
                        </Grid>
                        <Border Visibility="{Binding DataContext.InlineVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                Background="#F5FFFFFF" VerticalAlignment="Bottom" Height="78"
                                Margin="2" Padding="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox Text="{Binding DraftDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" AcceptsTab="False"
                                         TextWrapping="Wrap" MaxLength="32767"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="Tab／Shift+Tabで説明欄を移動。Ctrl+Enterで確定、Escで取り消し。"
                                         LostKeyboardFocus="InlineDescription_LostKeyboardFocus"
                                         PreviewKeyDown="InlineDescription_PreviewKeyDown"/>
                                <TextBlock Grid.Row="1" Text="{Binding StatusText}" ToolTip="{Binding StatusDetail}"
                                           FontSize="10" MinHeight="15">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#555555"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusText}" Value="保存失敗（再試行できます）">
                                                    <Setter Property="Foreground" Value="DarkRed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="未反映（再試行できます）">
                                                    <Setter Property="Foreground" Value="DarkRed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="画像が変更されました">
                                                    <Setter Property="Foreground" Value="DarkRed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <CheckBox Visibility="{Binding CheckBoxVisibility}" IsChecked="{Binding CheckBoxIsChecked}" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <CheckBox.Content>
                                <Grid>
                                    <Image Source="{Binding ImageSource}"/>
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Grid Background="White" Opacity="0.7"/>
                                        <TextBlock Text="{Binding Caption}"/>
                                    </Grid>
                                </Grid>
                            </CheckBox.Content>
                        </CheckBox>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid x:Name="imagePopupGrid" Visibility="Hidden" MouseLeftButtonUp="imagePopupGrid_MouseLeftButtonUp">
            <Grid Background="LightGray" Opacity="0.5"/>
            <Image x:Name="imagePopup"/>
        </Grid>

        <Grid x:Name="selectionGrid" Margin="2" Grid.Row="1" Visibility="{Binding SelectionVisibility}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="deleteButton" Content="削除" Click="deleteButton_Click" MinWidth="50"/>
                <Button x:Name="cancelButton" Content="キャンセル" Margin="5,0,0,0" Click="cancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
